//--------    FILE: abe.bhv   -------------

initialize   DEPLOY       = false
initialize   RETURN       = false
initialize   STATION_KEEP = false

//----------------------------------------------
Behavior = BHV_OpRegionV24
{
  name = opreg
  pwt  = 300

	core_poly = pts={-70.4,-50:56.1,10:90.4,-62.3:-36.11,-122.25}

	visual_hints = edge_size = 2 

	endflag = TEST1=true
	inactiveflag = TEST2=true
	
	save_dist = 5
	halt_dist = 14

	save_flag  = FOOBER=hello
	save_flag  = VAL1=$[DIST_TO_HALT]
	savex_flag = VAL2=$[DIST_TO_HALT]
	savex_flag = VAL3=$[TRAJ_DIST_TO_HALT]
	savex_flag = VAL4=$[SECS_OUT_SAVE_POLY]
}

//----------------------------------------------
Behavior=BHV_Waypoint
{
  name       = waypt_out
  pwt        = 100

  condition  = DEPLOY = true
  condition  = RETURN = false
  condition  = STATION_KEEP = false

           speed = 2.0
  capture_radius = 2.0
     slip_radius = 5.0
           point = 100,-20
 }


//----------------------------------------------
Behavior=BHV_Waypoint
{
  name       = waypt_return
  pwt        = 100

  condition  = DEPLOY = true
  condition  = RETURN = true
  condition  = STATION_KEEP = false


           speed = 1.0
  capture_radius = 7.0
     slip_radius = 10.0
           point = 0,0

         updates = RETURN_UPDATES
     spawnx_flag = RETURN_UPDATES=point=$[OSX],$[OSY]

  endflag = RETURN = false
  endflag = STATION_KEEP = true

 }

//----------------------------------------------
Behavior = BHV_StationKeep
{
  name      = station-keep
  pwt       = 100

  condition = DEPLOY = true
  condition = STATION_KEEP = true

     center_activate = true
        inner_radius = 5
        outer_radius = 10
         outer_speed = 1.0

       transit_speed = 1.3
          swing_time = 7
  hibernation_radius = 15
        visual_hints = vertex_size=0, edge_color=blue

}
